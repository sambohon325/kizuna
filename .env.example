KIZUNA_DATABASE_URL=sqlite:///./anime_studio.db
KIZUNA_ENVIRONMENT=development
KIZUNA_PUBLIC_URL=https://kizuna.technology
# Production must require accounts. Keep false only for isolated local development.
KIZUNA_AUTH_REQUIRED=false
KIZUNA_COOKIE_SECURE=false
KIZUNA_SESSION_DAYS=7
# Required by the production Docker stack for the one-time first administrator setup.
KIZUNA_BOOTSTRAP_ADMIN_KEY=
KIZUNA_GENERATION_PROVIDER=mock
KIZUNA_COMFYUI_URL=http://127.0.0.1:8188
# Export a ComfyUI workflow in API format and set its absolute path here.
KIZUNA_COMFYUI_WORKFLOW_PATH=
KIZUNA_COMFYUI_POSITIVE_NODE=6
KIZUNA_COMFYUI_NEGATIVE_NODE=7
KIZUNA_COMFYUI_SAMPLER_NODE=3
KIZUNA_WORKER_ENROLLMENT_SECRET=change-this-before-adding-workers
KIZUNA_WORKER_LEASE_SECONDS=300
KIZUNA_MAX_ARTIFACT_BYTES=67108864
KIZUNA_STORAGE_BACKEND=local
KIZUNA_STORAGE_DIRECTORY=storage
# Optional S3-compatible off-server vault (AWS S3, R2, MinIO, Backblaze, etc.).
KIZUNA_S3_BUCKET=
KIZUNA_S3_ENDPOINT_URL=
KIZUNA_S3_REGION=
KIZUNA_S3_PREFIX=kizuna
KIZUNA_S3_PRESIGN_SECONDS=900
# Use the standard AWS credential chain; never commit credentials here.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
KIZUNA_BACKUP_RETENTION_DAYS=30
KIZUNA_BACKUP_MAX_COPIES=10
KIZUNA_BACKUP_SCHEDULER_INTERVAL_SECONDS=60
# Cleanup approval requires replicas verified within this window. Approval never deletes by itself.
KIZUNA_CLEANUP_VERIFICATION_HOURS=24
# Durable work uses the database as its source of truth and Redis for fast worker wakeups.
# Leave Redis empty for the simple local, inline development mode.
KIZUNA_REDIS_URL=
KIZUNA_JOB_STREAM_KEY=kizuna:jobs
KIZUNA_JOB_LEASE_SECONDS=600
KIZUNA_JOB_POLL_SECONDS=2
KIZUNA_JOB_INLINE_FALLBACK=true
# Optional. When empty, Kizuna uses the bundled imageio-ffmpeg binary.
KIZUNA_FFMPEG_PATH=
# Optional real speech provider. Without this, the Sound Producer uses safe timing slates.
KIZUNA_OPENAI_API_KEY=
KIZUNA_VOICE_PROVIDER=simulation
KIZUNA_OPENAI_VOICE_MODEL=gpt-4o-mini-tts
KIZUNA_OPENAI_VOICE=coral
KIZUNA_WRITER_PROVIDER=simulation
KIZUNA_OPENAI_WRITER_MODEL=gpt-5.6-terra
KIZUNA_DIRECTOR_PROVIDER=simulation
KIZUNA_OPENAI_DIRECTOR_MODEL=gpt-5.6-terra
KIZUNA_VISUAL_AGENT_PROVIDER=simulation
KIZUNA_OPENAI_VISUAL_AGENT_MODEL=gpt-5.6-terra
KIZUNA_ANIMATOR_PROVIDER=simulation
KIZUNA_OPENAI_ANIMATOR_MODEL=gpt-5.6-terra
KIZUNA_EDITOR_PROVIDER=simulation
KIZUNA_OPENAI_EDITOR_MODEL=gpt-5.6-terra

# Optional provider-neutral originality and rights scanners. Configure the
# matching endpoint in Studio Settings; these variables hold credentials only.
KIZUNA_COMPLIANCE_TEXT_API_KEY=
KIZUNA_COMPLIANCE_TRADEMARK_API_KEY=
KIZUNA_COMPLIANCE_VISUAL_API_KEY=
KIZUNA_COMPLIANCE_AUDIO_API_KEY=

# Optional self-hosted reference scanner. Only index material your studio has
# a documented right or legitimate basis to use for comparison.
KIZUNA_SELF_HOSTED_SCANNER_API_KEY=
KIZUNA_SCANNER_API_KEY=
KIZUNA_SCANNER_ADMIN_KEY=
KIZUNA_SCANNER_CORPUS_DIRECTORY=scanner-corpus

# Required only by the independent professional-verification review service.
# Creators cannot use this key or verify themselves through the browser UI.
KIZUNA_VERIFICATION_ADMIN_KEY=
