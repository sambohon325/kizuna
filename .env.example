KIZUNA_DATABASE_URL=sqlite:///./anime_studio.db
KIZUNA_ENVIRONMENT=development
KIZUNA_GENERATION_PROVIDER=mock
KIZUNA_COMFYUI_URL=http://127.0.0.1:8188
# Export a ComfyUI workflow in API format and set its absolute path here.
KIZUNA_COMFYUI_WORKFLOW_PATH=
KIZUNA_COMFYUI_POSITIVE_NODE=6
KIZUNA_COMFYUI_NEGATIVE_NODE=7
KIZUNA_COMFYUI_SAMPLER_NODE=3
KIZUNA_WORKER_ENROLLMENT_SECRET=change-this-before-adding-workers
KIZUNA_WORKER_LEASE_SECONDS=300
KIZUNA_MAX_ARTIFACT_BYTES=67108864
# Optional. When empty, Kizuna uses the bundled imageio-ffmpeg binary.
KIZUNA_FFMPEG_PATH=
# Optional real speech provider. Without this, the Sound Producer uses safe timing slates.
KIZUNA_OPENAI_API_KEY=
KIZUNA_VOICE_PROVIDER=simulation
KIZUNA_OPENAI_VOICE_MODEL=gpt-4o-mini-tts
KIZUNA_OPENAI_VOICE=coral
KIZUNA_WRITER_PROVIDER=simulation
KIZUNA_OPENAI_WRITER_MODEL=gpt-5.6-terra
KIZUNA_DIRECTOR_PROVIDER=simulation
KIZUNA_OPENAI_DIRECTOR_MODEL=gpt-5.6-terra
KIZUNA_VISUAL_AGENT_PROVIDER=simulation
KIZUNA_OPENAI_VISUAL_AGENT_MODEL=gpt-5.6-terra
KIZUNA_ANIMATOR_PROVIDER=simulation
KIZUNA_OPENAI_ANIMATOR_MODEL=gpt-5.6-terra
KIZUNA_EDITOR_PROVIDER=simulation
KIZUNA_OPENAI_EDITOR_MODEL=gpt-5.6-terra
